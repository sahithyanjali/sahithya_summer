rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }
    
    function isCoordinator() {
      return isAuthenticated() && (request.auth.token.role == 'COORDINATOR' || isAdmin());
    }

    // users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isCoordinator();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
      allow delete: if isAdmin();
    }

    // volunteer_profiles collection
    match /volunteer_profiles/{userId} {
      allow read: if isOwner(userId) || isCoordinator();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['backgroundCheckStatus', 'identityVerified']);
      allow delete: if isAdmin();
    }

    // opportunities collection
    match /opportunities/{oppId} {
      allow read: if isAuthenticated();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // applications collection
    match /applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.volunteerId == request.auth.uid || isCoordinator());
      allow create: if isAuthenticated() && request.resource.data.volunteerId == request.auth.uid;
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (resource.data.volunteerId == request.auth.uid || isCoordinator());
      allow write: if isCoordinator();
    }

    // notifications collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow write: if isAdmin();
    }

    // engagements collection
    match /engagements/{engId} {
      allow read: if isAuthenticated();
      allow write: if isCoordinator();
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
