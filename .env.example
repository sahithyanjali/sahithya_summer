# =============================================================================
# SEVA SPHOORTHI PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# NOTE: DO NOT commit real secrets to Git or bundle them in client builds.
# Inject production secrets via Google Cloud Run Secret Manager or platform env vars.

# Application Server
PORT=8080
NODE_ENV=production
CORS_ORIGIN=*
APP_URL=https://sevasphoorthi.org

# AI Studio / Gemini AI Platform
# Inject your Google AI Studio / Vertex API key for volunteer skill semantic matching
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK (Production Firestore & Firebase Auth)
# Used for server-side token verification and direct collection sync
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# SMS Gateway (Twilio)
# Used for delivering real 6-digit OTPs for volunteer mobile sign-in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Alternative SMS Provider (Fast2SMS for India DLT registered routes)
FAST2SMS_API_KEY=

# Payment Gateway (Razorpay)
# RAZORPAY_KEY_ID: Public Key ID (e.g. rzp_live_XXXX or rzp_test_XXXX)
# RAZORPAY_KEY_SECRET: Confidential backend key secret for order creation & HMAC verification
# RAZORPAY_WEBHOOK_SECRET: Secret for verifying webhook event signatures
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Maps Platform
# Used for geocoding relief camp addresses and route distance calculations
GOOGLE_MAPS_API_KEY=

# Cloud Storage
# GCS Bucket for permanent storage of volunteer ID proofs and documents
GCS_BUCKET_NAME=
UPLOAD_DIR=data/uploads

# Google Play Console App Reviewer Credentials
# Reusable verification method providing volunteer-level access only (no admin/financial privileges)
REVIEWER_PHONE_NUMBER=
REVIEWER_OTP=

# Administrative Authentication Configuration
# Environment secret key for authenticating authorized Seva Trustees (Fail-closed if unconfigured)
ADMIN_SECRET_KEY=
